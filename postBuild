#!/bin/bash

# 1. Pastikan folder bin lokal ada dan memiliki hak akses penuh
mkdir -p $HOME/.local/bin
chmod -R 755 $HOME/.local

# 2. Unduh dan pasang code-server secara lokal tanpa root
curl -fsSL https://code-server.dev | sh -s -- --user-limit

# 3. Unduh aplikasi ttyd binary secara manual untuk terminal di browser
curl -L https://github.com -o $HOME/.local/bin/ttyd
chmod +x $HOME/.local/bin/ttyd

# 4. Unduh Chromium portabel resmi untuk Linux Ubuntu secara otomatis
echo "Mengunduh Chromium portabel..."
mkdir -p $HOME/chromium
curl -L "https://appspot.com" -o $HOME/chromium/chromium-linux.zip
unzip -q $HOME/chromium/chromium-linux.zip -d $HOME/chromium/
rm $HOME/chromium/chromium-linux.zip
ln -sf $HOME/chromium/chrome-linux/chrome $HOME/.local/bin/chromium

# 4. Bersihkan sisa-sisa konfigurasi VNC lama yang terkunci di sistem
rm -rf $HOME/.vnc
mkdir -p $HOME/.vnc

# 5. Jalankan penginstalan paket Express untuk proyek Node.js Anda
npm install
